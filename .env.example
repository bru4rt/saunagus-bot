# --- Saunagus Auto-Booking Config ---

BOOK_URL=https://book.easytable.com/book/?id=PLACE_ID&lang=auto

# Booking preferences
LEAD_DAYS=7
POLICY=earliest
GUESTS=1

# Personal data shown on booking form
FIRST_NAME=First
LAST_NAME=Last
COMMENT=Optional comment

# Login / user identification (if a 'Username' field exists)
USER_NAME=username

# Contact fields (optional – enable if requested)
EMAIL=you@example.com
MOBILE=4512345678

# Email confirmation watcher (optional)
# IMAP_HOST=imap.mailprovider.com
# IMAP_USER=you@example.com
# IMAP_PASSWORD=app_password
# IMAP_FROM_CONTAINS=easytable
# IMAP_SUBJECT_CONTAINS=booking
# CONFIRMATION_TIMEOUT_MIN=15

# Runner settings
DRY_RUN=true
HEADLESS=false
LEAD_DAYS=7
GUESTS=1
RETRY_INTERVAL_MIN=30
